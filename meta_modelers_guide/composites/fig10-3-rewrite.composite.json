{
  "name": "Evolution \u2014 Live Topology",
  "description": "Fig 10.3 (evolution) as a GENUINE place-graph rewrite: a wildtype population establishes (organism nodes added), a fitter MUTANT arises, then a selection sweep adds mutant offspring and prunes wildtype until the mutant lineage takes over. Running it ADDS and REMOVES place-graph nodes at runtime \u2014 steppable topology for the loom run/animate feature.",
  "default_n_steps": 18,
  "requires": {
    "processes": [
      "LineageEvolution"
    ]
  },
  "parameters": {
    "founders": {
      "type": "int",
      "default": 3,
      "description": "Initial wildtype founder organisms."
    },
    "capacity": {
      "type": "int",
      "default": 6,
      "description": "Population carrying capacity."
    },
    "generation": {
      "type": "float",
      "default": 2.0,
      "description": "Time between generations (reproduction events)."
    },
    "mutate_at": {
      "type": "float",
      "default": 4.0,
      "description": "Time at which the fitter mutant lineage first appears."
    }
  },
  "state": {
    "population": {
      "_type": "tree[node]",
      "organism": {
        "_control": "organism",
        "contents": {
          "fitness": 1.0
        }
      }
    },
    "evolution": {
      "_type": "process",
      "address": "local:LineageEvolution",
      "interval": 1.0,
      "config": {
        "generation": "${generation}",
        "mutate_at": "${mutate_at}",
        "founders": "${founders}",
        "capacity": "${capacity}"
      },
      "inputs": {
        "population": [
          "population"
        ]
      },
      "outputs": {
        "population": [
          "population"
        ]
      }
    }
  },
  "emitters": [
    {
      "address": "local:SQLiteEmitter"
    }
  ]
}
