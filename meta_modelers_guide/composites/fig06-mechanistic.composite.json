{
  "name": "F₁Fₒ ATP Synthase — Mechanistic Rotary Motor (load sweep → stall → reversal)",
  "description": "Fig 6 upgraded to a real reduced rotary-motor model (AtpSynthaseRotor). The membrane holds a proton-motive force Δp = 150 mV; a MechanicalLoad ramps the external shaft torque linearly past the stall point. Torque, speed, proton/ATP flux, the power split and efficiency are all DERIVED from Δp, the ATP free energy ΔG_ATP, and the load — not imposed. Over the 20-tick run the rotor turns forward (synthesising ATP), slows as the load rises, STALLS when τ_ext = τ_drive−τ_chem (≈ tick 10), then REVERSES (ω<0 → ATP hydrolysis pumping protons). The power budget P_in = P_ATP + P_ext + P_heat closes exactly on every step. This is the mechanistic variant of fig06-runnable (kept as the algebraic didactic baseline).",
  "default_n_steps": 20,
  "requires": {
    "processes": [
      "AtpSynthaseRotor",
      "MembranePMF",
      "MechanicalLoad"
    ]
  },
  "provenance": {
    "figure": "fig06-molecular-mechanism",
    "environment": "fig06-mechanistic",
    "handlers": {
      "AtpSynthaseRotor": {
        "handler": "AtpSynthaseRotor",
        "process_term": "GO:0046933 proton-transporting ATP synthase activity, rotational mechanism"
      }
    }
  },
  "state": {
    "rotor": {
      "_type": "process",
      "address": "local:AtpSynthaseRotor",
      "interval": 1.0,
      "config": {
        "n_c": 10.0,
        "atp_per_rev": 3.0,
        "drag": 1.0e-23,
        "dg0_kjmol": 30.5,
        "temperature": 298.15,
        "buffer_pools": true,
        "min_conc": 1.0e-6
      },
      "inputs": {
        "pmf": ["membrane", "pmf"],
        "load_torque": ["load", "torque"],
        "atp": ["pools", "atp"],
        "adp": ["pools", "adp"],
        "pi": ["pools", "pi"]
      },
      "outputs": {
        "omega": ["signals", "omega"],
        "angle": ["signals", "angle"],
        "proton_flux": ["signals", "proton_flux"],
        "proton_current": ["signals", "proton_current"],
        "atp_flux": ["signals", "atp_flux"],
        "drive_torque": ["signals", "drive_torque"],
        "chem_torque": ["signals", "chem_torque"],
        "net_torque": ["signals", "net_torque"],
        "dg_atp": ["signals", "dg_atp"],
        "power_in": ["signals", "power_in"],
        "power_atp": ["signals", "power_atp"],
        "power_ext": ["signals", "power_ext"],
        "power_heat": ["signals", "power_heat"],
        "efficiency": ["signals", "efficiency"],
        "atp": ["pools", "atp"],
        "adp": ["pools", "adp"],
        "pi": ["pools", "pi"]
      }
    },
    "membrane_pmf": {
      "_type": "process",
      "address": "local:MembranePMF",
      "interval": 1.0,
      "config": {"pmf0": 0.150, "dpmf_dt": 0.0, "pmf_min": 0.0},
      "inputs": {},
      "outputs": {"pmf": ["membrane", "pmf"]}
    },
    "mechanical_load": {
      "_type": "process",
      "address": "local:MechanicalLoad",
      "interval": 1.0,
      "config": {"load0": 0.0, "load_rate": 6.5e-22},
      "inputs": {},
      "outputs": {"load_torque": ["load", "torque"]}
    },
    "membrane": {"pmf": {"_type": "voltage", "_default": 0.150}},
    "load": {"torque": {"_type": "torque", "_default": 0.0}},
    "pools": {
      "atp": {"_type": "concentration", "_default": 10.0},
      "adp": {"_type": "concentration", "_default": 1.0},
      "pi": {"_type": "concentration", "_default": 0.2}
    },
    "signals": {
      "omega": {"_type": "float", "_default": 0.0},
      "angle": {"_type": "angle", "_default": 0.0},
      "proton_flux": {"_type": "float", "_default": 0.0},
      "proton_current": {"_type": "current", "_default": 0.0},
      "atp_flux": {"_type": "chemical_flux", "_default": 0.0},
      "drive_torque": {"_type": "torque", "_default": 0.0},
      "chem_torque": {"_type": "torque", "_default": 0.0},
      "net_torque": {"_type": "torque", "_default": 0.0},
      "dg_atp": {"_type": "energy", "_default": 0.0},
      "power_in": {"_type": "power", "_default": 0.0},
      "power_atp": {"_type": "power", "_default": 0.0},
      "power_ext": {"_type": "power", "_default": 0.0},
      "power_heat": {"_type": "heat_flux", "_default": 0.0},
      "efficiency": {"_type": "float", "_default": 0.0}
    },
    "emitter": {
      "_type": "step",
      "address": "local:RAMEmitter",
      "config": {
        "emit": {
          "pmf": "voltage",
          "load_torque": "torque",
          "omega": "float",
          "atp_flux": "chemical_flux",
          "proton_current": "current",
          "drive_torque": "torque",
          "chem_torque": "torque",
          "net_torque": "torque",
          "dg_atp": "energy",
          "power_in": "power",
          "power_atp": "power",
          "power_ext": "power",
          "power_heat": "heat_flux",
          "efficiency": "float",
          "time": "float"
        }
      },
      "inputs": {
        "pmf": ["membrane", "pmf"],
        "load_torque": ["load", "torque"],
        "omega": ["signals", "omega"],
        "atp_flux": ["signals", "atp_flux"],
        "proton_current": ["signals", "proton_current"],
        "drive_torque": ["signals", "drive_torque"],
        "chem_torque": ["signals", "chem_torque"],
        "net_torque": ["signals", "net_torque"],
        "dg_atp": ["signals", "dg_atp"],
        "power_in": ["signals", "power_in"],
        "power_atp": ["signals", "power_atp"],
        "power_ext": ["signals", "power_ext"],
        "power_heat": ["signals", "power_heat"],
        "efficiency": ["signals", "efficiency"],
        "time": ["global_time"]
      }
    }
  }
}
