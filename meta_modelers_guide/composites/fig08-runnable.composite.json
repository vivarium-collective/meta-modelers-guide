{
  "name": "The Minimal Cell — Autopoietic Closure (runnable)",
  "description": "Fig 8 as a fully runnable temporal study: the minimal cell's six coupled processes wired over FLAT scalar building-block pools (the form the ODE handlers actually integrate — membrane, lipids, metabolites, nutrients, amino_acids, nucleic_acids, enzymes, proteins, genes, energy as flat leaves). Containment assembles membrane from lipids; metabolism turns enzymes+nutrients into metabolites+energy; gene expression translates genes+amino_acids into proteins+enzymes; replication copies genes by spending energy and returns nucleic_acids; diffusion turns the metabolite pool over; mass-action reactions interconvert building blocks. Because the processes SHARE these pools, none stands alone — expression makes the enzymes metabolism needs, metabolism makes the energy replication spends, replication grows the gene template. This mutual production through shared components is autopoietic closure: run it and the catalytic/template pools (genes, energy, metabolites, nucleic_acids) hold a sustained steady balance while the cell's structural material (membrane, proteins, enzymes) accumulates — nothing collapses to zero, nothing explodes. This is the demonstration behind Fig 8b (the published draft nests these pools into container stores for display; the scalar-pool wiring here is what the handlers run). Runnable (default_n_steps + RAMEmitter).",
  "default_n_steps": 40,
  "requires": {
    "processes": [
      "ContainmentODE",
      "MetabolismLinear",
      "GeneExpressionODE",
      "ReplicationODE",
      "DiffusionRelax",
      "MassActionReactions"
    ],
    "types": [
      "concentration",
      "area",
      "energy"
    ]
  },
  "provenance": {
    "figure": "fig08b-minimal-cell",
    "environment": "fig08b",
    "handlers": {
      "MinimalCellContainment": {"handler": "ContainmentODE"},
      "MinimalCellMetabolism": {"handler": "MetabolismLinear"},
      "GeneExpression": {"handler": "GeneExpressionODE"},
      "MinimalCellReplication": {"handler": "ReplicationODE"},
      "Diffusion": {"handler": "DiffusionRelax"},
      "Reactions": {"handler": "MassActionReactions"}
    }
  },
  "state": {
    "containment": {
      "_type": "process",
      "address": "local:ContainmentODE",
      "interval": 1.0,
      "config": {"assembly_rate": 0.05},
      "inputs": {"lipids": ["lipids"]},
      "outputs": {"membrane": ["membrane"]}
    },
    "metabolism": {
      "_type": "process",
      "address": "local:MetabolismLinear",
      "interval": 1.0,
      "config": {"k_cat": 0.1, "metabolite_yield": 0.6, "energy_yield": 0.05},
      "inputs": {"enzymes": ["enzymes"], "nutrients": ["nutrients"]},
      "outputs": {"metabolites": ["metabolites"], "energy": ["energy"]}
    },
    "gene_expression": {
      "_type": "process",
      "address": "local:GeneExpressionODE",
      "interval": 1.0,
      "config": {"k_expr": 0.08, "protein_yield": 0.15, "enzyme_yield": 0.06},
      "inputs": {"genes": ["genes"], "amino_acids": ["amino_acids"]},
      "outputs": {"proteins": ["proteins"], "enzymes": ["enzymes"]}
    },
    "replication": {
      "_type": "process",
      "address": "local:ReplicationODE",
      "interval": 1.0,
      "config": {"k_rep": 0.015, "gene_yield": 0.2, "nucleic_yield": 0.4},
      "inputs": {"genes": ["genes"], "energy": ["energy"]},
      "outputs": {"genes": ["genes"], "nucleic_acids": ["nucleic_acids"]}
    },
    "diffusion": {
      "_type": "process",
      "address": "local:DiffusionRelax",
      "interval": 1.0,
      "config": {"turnover_rate": 0.08},
      "inputs": {"metabolites": ["metabolites"]},
      "outputs": {"metabolites": ["metabolites"]}
    },
    "reactions": {
      "_type": "process",
      "address": "local:MassActionReactions",
      "interval": 1.0,
      "config": {"k_react": 0.06, "protein_yield": 0.12, "nucleic_turnover": 0.2},
      "inputs": {"amino_acids": ["amino_acids"], "nucleic_acids": ["nucleic_acids"]},
      "outputs": {"proteins": ["proteins"], "nucleic_acids": ["nucleic_acids"]}
    },

    "lipids": {"_type": "concentration", "_value": 1.0, "_default": 1.0},
    "membrane": {"_type": "area", "_value": 0.2, "_default": 0.2},
    "nutrients": {"_type": "concentration", "_value": 1.0, "_default": 1.0},
    "metabolites": {"_type": "concentration", "_value": 0.3, "_default": 0.3},
    "enzymes": {"_type": "concentration", "_value": 0.3, "_default": 0.3},
    "proteins": {"_type": "concentration", "_value": 0.3, "_default": 0.3},
    "genes": {"_type": "concentration", "_value": 1.0, "_default": 1.0},
    "energy": {"_type": "energy", "_value": 0.5, "_default": 0.5},
    "amino_acids": {"_type": "concentration", "_value": 1.0, "_default": 1.0},
    "nucleic_acids": {"_type": "concentration", "_value": 0.3, "_default": 0.3},

    "emitter": {
      "_type": "step",
      "address": "local:RAMEmitter",
      "config": {
        "emit": {
          "membrane": "area",
          "metabolites": "concentration",
          "enzymes": "concentration",
          "proteins": "concentration",
          "genes": "concentration",
          "energy": "energy",
          "nucleic_acids": "concentration",
          "time": "float"
        }
      },
      "inputs": {
        "membrane": ["membrane"],
        "metabolites": ["metabolites"],
        "enzymes": ["enzymes"],
        "proteins": ["proteins"],
        "genes": ["genes"],
        "energy": ["energy"],
        "nucleic_acids": ["nucleic_acids"],
        "time": ["global_time"]
      }
    },
    "dynamics_viz": {
      "_type": "step",
      "address": "local:DynamicsPlot",
      "config": {
        "title": "The minimal cell sustains itself — autopoietic closure",
        "subtitle": "Fig 8 — containment, metabolism, gene-expression & replication mutually produce the pools that sustain each other",
        "observables": {
          "membrane": "float",
          "metabolites": "float",
          "proteins": "float",
          "genes": "float",
          "energy": "float"
        }
      },
      "inputs": {
        "membrane": ["membrane"],
        "metabolites": ["metabolites"],
        "proteins": ["proteins"],
        "genes": ["genes"],
        "energy": ["energy"],
        "time": ["global_time"]
      },
      "outputs": {
        "html": ["_viz", "dynamicsplot"]
      }
    }
  }
}
