{
  "name": "Growth & Division — a growth-, energy- and size-gated cell cycle (nucleotide-accounted)",
  "description": "Fig 9 mechanistic variant. The same colony tree[node] rewrite as the baseline, but division is now an OUTCOME of physiology: each cell grows by taking up a shared, finite nutrient (saturating Michaelis–Menten), replicates its chromosome only once it has grown past V_rep and has the nucleotides+energy for it (DNA drawn FROM the nucleotide pool, so DNA+nucleotides is conserved — no DNA from nothing), and divides ONLY when volume ≥ V_div AND it has replicated AND energy ≥ div_cost, partitioning volume/energy/nucleotides/biomass/chromosomes between two daughters that continue. 1→2→4→8→16 happens, but only when the cells actually grow; starve the nutrient and the checkpoint is never met — division is delayed, not clocked.",
  "default_n_steps": 20,
  "requires": {"processes": ["GrowthDivisionColony"]},
  "provenance": {"figure": "fig09-division", "environment": "fig09-mechanistic"},
  "state": {
    "cell_cycle": {
      "_type": "process",
      "address": "local:GrowthDivisionColony",
      "interval": 1.0,
      "config": {"vmax": 0.6, "km": 5.0, "grow_vol": 0.5, "grow_energy": 0.4,
                 "grow_biomass": 0.3, "grow_nuc": 0.3, "v_rep": 1.4, "v_div": 1.8,
                 "rep_rate": 1.0, "atp_per_dna": 0.1, "div_cost": 0.1, "capacity": 16.0},
      "inputs": {"colony": ["colony"], "substrate": ["environment", "substrate"]},
      "outputs": {
        "colony": ["colony"],
        "substrate": ["environment", "substrate"],
        "cell_count": ["stats", "cell_count"],
        "tot_volume": ["stats", "tot_volume"],
        "tot_dna": ["stats", "tot_dna"],
        "tot_nucleotides": ["stats", "tot_nucleotides"],
        "tot_biomass": ["stats", "tot_biomass"],
        "tot_energy": ["stats", "tot_energy"],
        "divisions": ["stats", "divisions"]
      }
    },
    "colony": {
      "_type": "tree[node]",
      "cell": {
        "_control": "cell",
        "volume": 1.0,
        "energy": 1.0,
        "nucleotides": 2.0,
        "biomass": 1.0,
        "generation": 0,
        "contents": {"chromosome": {"_control": "chromosome", "contents": {"dna": 1.0}}}
      }
    },
    "environment": {"substrate": {"_type": "concentration", "_default": 200.0}},
    "stats": {
      "cell_count": {"_type": "float", "_default": 0.0},
      "tot_volume": {"_type": "float", "_default": 0.0},
      "tot_dna": {"_type": "float", "_default": 0.0},
      "tot_nucleotides": {"_type": "float", "_default": 0.0},
      "tot_biomass": {"_type": "float", "_default": 0.0},
      "tot_energy": {"_type": "float", "_default": 0.0},
      "divisions": {"_type": "float", "_default": 0.0}
    },
    "emitter": {
      "_type": "step",
      "address": "local:RAMEmitter",
      "config": {"emit": {"cell_count": "float", "tot_volume": "float", "tot_dna": "float",
                          "tot_nucleotides": "float", "tot_biomass": "float", "tot_energy": "float",
                          "divisions": "float", "substrate": "concentration", "time": "float"}},
      "inputs": {"cell_count": ["stats", "cell_count"], "tot_volume": ["stats", "tot_volume"],
                 "tot_dna": ["stats", "tot_dna"], "tot_nucleotides": ["stats", "tot_nucleotides"],
                 "tot_biomass": ["stats", "tot_biomass"], "tot_energy": ["stats", "tot_energy"],
                 "divisions": ["stats", "divisions"], "substrate": ["environment", "substrate"],
                 "time": ["global_time"]}
    }
  }
}
