{
  "name": "Disintegration (playable)",
  "description": "Fig 5a — cell disintegration as a playable trajectory: a thermal shock pushes the cell past its viability bound; viability collapses, viability-gated metabolism halts, and biomass decays into molecular debris (cell→molecular level shift). Assembled in the figures' style (see wholecell.py), not compiler-emitted. Play it to watch the collapse.",
  "requires": {
    "processes": [
      "ThermalEnvironment",
      "Uptake",
      "ViabilityGatedMetabolism",
      "ViabilityMonitor",
      "DisintegrationEvent"
    ]
  },
  "state": {
    "environment": {
      "nutrients": {
        "_type": "concentration",
        "_default": 1.0
      },
      "temperature": {
        "_type": "temperature",
        "_default": 37.0
      }
    },
    "cell": {
      "biomass": {
        "_type": "mass",
        "_default": 0.3
      },
      "energy": {
        "_type": "energy",
        "_default": 0.0
      },
      "viability": {
        "_type": "viability",
        "_default": 1.0
      },
      "nutrients_local": {
        "_type": "concentration",
        "_default": 0.0
      },
      "dividing": {
        "_type": "fraction",
        "_default": 0.0
      },
      "disintegrating": {
        "_type": "fraction",
        "_default": 0.0
      },
      "debris": {
        "_type": "concentration",
        "_default": 0.0
      }
    },
    "thermal": {
      "_type": "process",
      "address": "local:ThermalEnvironment",
      "config": {
        "temp_normal": 37.0,
        "temp_shock": 50.0,
        "shock_time": 8.0
      },
      "interval": 1.0,
      "inputs": {},
      "outputs": {
        "temperature": [
          "environment",
          "temperature"
        ]
      }
    },
    "uptake": {
      "_type": "process",
      "address": "local:Uptake",
      "config": {
        "uptake_rate": 0.5
      },
      "interval": 1.0,
      "inputs": {
        "nutrients_ext": [
          "environment",
          "nutrients"
        ]
      },
      "outputs": {
        "nutrients_local": [
          "cell",
          "nutrients_local"
        ]
      }
    },
    "metabolism": {
      "_type": "process",
      "address": "local:ViabilityGatedMetabolism",
      "config": {
        "mode": "coarse",
        "k": 0.6,
        "energy_yield": 0.4
      },
      "interval": 1.0,
      "inputs": {
        "nutrients_local": [
          "cell",
          "nutrients_local"
        ],
        "viability": [
          "cell",
          "viability"
        ]
      },
      "outputs": {
        "biomass": [
          "cell",
          "biomass"
        ],
        "energy": [
          "cell",
          "energy"
        ],
        "nutrients_local": [
          "cell",
          "nutrients_local"
        ]
      }
    },
    "monitor": {
      "_type": "process",
      "address": "local:ViabilityMonitor",
      "config": {
        "temp_opt": 37.0,
        "temp_tol": 5.0,
        "relax": 0.5,
        "division_threshold": 1000000000.0,
        "viability_floor": 0.5
      },
      "interval": 1.0,
      "inputs": {
        "temperature": [
          "environment",
          "temperature"
        ],
        "biomass": [
          "cell",
          "biomass"
        ],
        "viability": [
          "cell",
          "viability"
        ]
      },
      "outputs": {
        "viability": [
          "cell",
          "viability"
        ],
        "dividing": [
          "cell",
          "dividing"
        ],
        "disintegrating": [
          "cell",
          "disintegrating"
        ]
      }
    },
    "disintegration": {
      "_type": "process",
      "address": "local:DisintegrationEvent",
      "config": {
        "decay_rate": 0.4
      },
      "interval": 1.0,
      "inputs": {
        "biomass": [
          "cell",
          "biomass"
        ],
        "disintegrating": [
          "cell",
          "disintegrating"
        ]
      },
      "outputs": {
        "biomass": [
          "cell",
          "biomass"
        ],
        "debris": [
          "cell",
          "debris"
        ]
      }
    },
    "emitter": {
      "_type": "step",
      "address": "local:RAMEmitter",
      "config": {
        "emit": {
          "biomass": "mass",
          "viability": "viability",
          "temperature": "temperature",
          "debris": "concentration",
          "disintegrating": "fraction",
          "time": "float"
        }
      },
      "inputs": {
        "biomass": [
          "cell",
          "biomass"
        ],
        "viability": [
          "cell",
          "viability"
        ],
        "temperature": [
          "environment",
          "temperature"
        ],
        "debris": [
          "cell",
          "debris"
        ],
        "disintegrating": [
          "cell",
          "disintegrating"
        ],
        "time": [
          "global_time"
        ]
      }
    },
    "dynamics_viz": {
      "_type": "step",
      "address": "local:DynamicsPlot",
      "config": {
        "title": "Disintegration — the cell → molecular level shift",
        "observables": {
          "temperature": "float",
          "biomass": "float",
          "viability": "float",
          "debris": "float"
        },
        "subtitle": "Fig 5 — a thermal shock pushes the cell past its viability bound",
        "secondary_y": [
          "temperature"
        ],
        "area": [
          "debris"
        ],
        "phases": [
          {
            "x0": 0,
            "x1": 8,
            "label": "viable",
            "color": "#1c7a77"
          },
          {
            "x0": 8,
            "x1": 20,
            "label": "disintegrating",
            "color": "#b4531f"
          }
        ],
        "events": [
          {
            "x": 8,
            "label": "thermal shock (37→50 °C)"
          }
        ]
      },
      "inputs": {
        "temperature": [
          "environment",
          "temperature"
        ],
        "biomass": [
          "cell",
          "biomass"
        ],
        "viability": [
          "cell",
          "viability"
        ],
        "debris": [
          "cell",
          "debris"
        ],
        "time": [
          "global_time"
        ]
      },
      "outputs": {
        "html": [
          "_viz",
          "dynamicsplot"
        ]
      }
    }
  }
}