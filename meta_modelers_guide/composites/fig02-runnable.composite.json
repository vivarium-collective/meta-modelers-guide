{
  "name": "Orchestration — multi-timestepping through a shared store",
  "description": "Fig 2a made runnable at the smallest honest scale: TWO processes updating at DIFFERENT rates through ONE shared pool store. FastProduction (interval 1.0) adds to pool.molecules every base tick; SlowConversion (interval 5.0) fires once per 5 ticks, converting a fraction of the accumulated pool into pool.biomass and drawing it back out. molecules ramps on the fast clock and saws down each slow firing while biomass advances in coarse staircase steps — two rates coordinated on one clock through a shared store. This is the dynamics behind Fig 2's multi-timestepping panel (a) only; panels (b) workflow-DAG and (c) event rewrites stay schematic. Runnable (default_n_steps + RAMEmitter).",
  "default_n_steps": 20,
  "requires": {
    "processes": [
      "FastProduction",
      "SlowConversion"
    ]
  },
  "provenance": {
    "figure": "overview-multiscale-composite",
    "panel": "a — multi-timestepping"
  },
  "state": {
    "pool": {
      "molecules": {
        "_type": "float",
        "_default": 0.0,
        "_value": 0.0
      },
      "biomass": {
        "_type": "float",
        "_default": 0.0,
        "_value": 0.0
      }
    },
    "fast": {
      "_type": "process",
      "address": "local:FastProduction",
      "interval": 1.0,
      "config": {
        "rate": 1.0
      },
      "inputs": {
        "molecules": [
          "pool",
          "molecules"
        ]
      },
      "outputs": {
        "molecules": [
          "pool",
          "molecules"
        ]
      }
    },
    "slow": {
      "_type": "process",
      "address": "local:SlowConversion",
      "interval": 5.0,
      "config": {
        "yield_frac": 0.6
      },
      "inputs": {
        "molecules": [
          "pool",
          "molecules"
        ]
      },
      "outputs": {
        "molecules": [
          "pool",
          "molecules"
        ],
        "biomass": [
          "pool",
          "biomass"
        ]
      }
    },
    "emitter": {
      "_type": "step",
      "address": "local:RAMEmitter",
      "config": {
        "emit": {
          "molecules": "float",
          "biomass": "float",
          "time": "float"
        }
      },
      "inputs": {
        "molecules": [
          "pool",
          "molecules"
        ],
        "biomass": [
          "pool",
          "biomass"
        ],
        "time": [
          "global_time"
        ]
      }
    },
    "dynamics_viz": {
      "_type": "step",
      "address": "local:DynamicsPlot",
      "config": {
        "title": "Multi-timestepping: two rates coordinated through a shared store",
        "observables": {
          "molecules": "float",
          "biomass": "float"
        },
        "subtitle": "Fig 2a — fast pool fill (interval 1) saws down each slow conversion (interval 5) into biomass"
      },
      "inputs": {
        "molecules": [
          "pool",
          "molecules"
        ],
        "biomass": [
          "pool",
          "biomass"
        ],
        "time": [
          "global_time"
        ]
      },
      "outputs": {
        "html": [
          "_viz",
          "dynamicsplot"
        ]
      }
    }
  }
}
