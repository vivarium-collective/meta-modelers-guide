{"id": "viva_meta_modelers_guide.composites.fig10-3-rewrite", "name": "Evolution \u2014 Live Topology", "description": "Fig 10.3 (evolution) as a GENUINE place-graph rewrite: a wildtype population establishes (organism nodes added), a fitter MUTANT arises, then a selection sweep adds mutant offspring and prunes wildtype until the mutant lineage takes over. Running it ADDS and REMOVES place-graph nodes at runtime \u2014 steppable topology for the loom run/animate feature.", "parameters": {"founders": {"type": "integer", "default": 3, "description": "Initial wildtype founder organisms."}, "capacity": {"type": "integer", "default": 6, "description": "Population carrying capacity."}, "generation": {"type": "float", "default": 2.0, "description": "Time between generations (reproduction events)."}, "mutate_at": {"type": "float", "default": 4.0, "description": "Time at which the fitter mutant lineage first appears."}}, "state": {"population": {"_type": "tree[node]", "organism": {"_control": "organism", "contents": {"fitness": 1.0}}}, "evolution": {"_type": "process", "address": "local:LineageEvolution", "interval": 1.0, "config": {"generation": 2.0, "mutate_at": 4.0, "founders": 3, "capacity": 6}, "inputs": {"population": ["population"]}, "outputs": {"population": ["population"]}}}, "schema": {}, "requires": {"processes": ["LineageEvolution"]}, "tags": [], "visualizations": [], "analyses": [], "emitters": [{"address": "local:SQLiteEmitter"}], "kind": "spec", "module": "", "default_n_steps": 18, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}