{"id": "meta_modelers_guide.composites.fig07-mechanistic", "name": "Nested Cellular Hierarchy \u2014 Permeable Boundaries Gate a Deep Observable", "description": "Fig 7 mechanistic variant. A genuinely nested place graph (environment \u2283 cell \u2283 cytoplasm \u2283 nucleus) in which the nesting INFLUENCES FUNCTION, not just routes a scalar. Two PermeableBoundary processes (plasma membrane: environment\u2194cytoplasm; nuclear envelope: cytoplasm\u2194nucleus) gate passive, conservative transport of a substrate inward. A locally-restricted LocalMetabolism consumes substrate only in the cytoplasm; a RegulatedReporter in the nucleus turns the substrate that reaches it into a reporter (regulatory dependence). Because the nuclear substrate depends on BOTH permeabilities in series, lowering either boundary's permeability shuts the deep reporter down \u2014 a boundary-level cause with a deep functional effect. Transport is conservative, so with the reactions off the total substrate across all compartments is invariant.", "parameters": {}, "state": {"membrane": {"_type": "process", "address": "local:PermeableBoundary", "interval": 1.0, "config": {"permeability": 0.3}, "inputs": {"outer": ["environment", "substrate"], "inner": ["environment", "cell", "cytoplasm", "substrate"]}, "outputs": {"outer": ["environment", "substrate"], "inner": ["environment", "cell", "cytoplasm", "substrate"]}, "interval_label": "1 s"}, "nuclear_envelope": {"_type": "process", "address": "local:PermeableBoundary", "interval": 1.0, "config": {"permeability": 0.3}, "inputs": {"outer": ["environment", "cell", "cytoplasm", "substrate"], "inner": ["environment", "cell", "cytoplasm", "nucleus", "substrate"]}, "outputs": {"outer": ["environment", "cell", "cytoplasm", "substrate"], "inner": ["environment", "cell", "cytoplasm", "nucleus", "substrate"]}, "interval_label": "1 s"}, "cytoplasmic_metabolism": {"_type": "process", "address": "local:LocalMetabolism", "interval": 1.0, "config": {"k": 0.05}, "inputs": {"substrate": ["environment", "cell", "cytoplasm", "substrate"]}, "outputs": {"substrate": ["environment", "cell", "cytoplasm", "substrate"]}, "interval_label": "1 s"}, "nuclear_reporter": {"_type": "process", "address": "local:RegulatedReporter", "interval": 1.0, "config": {"k_prod": 0.4, "k_deg": 0.1}, "inputs": {"substrate": ["environment", "cell", "cytoplasm", "nucleus", "substrate"]}, "outputs": {"reporter": ["environment", "cell", "cytoplasm", "nucleus", "reporter"]}, "interval_label": "1 s"}, "environment": {"substrate": {"_type": "concentration", "_default": 10.0}, "cell": {"cytoplasm": {"substrate": {"_type": "concentration", "_default": 0.0}, "nucleus": {"substrate": {"_type": "concentration", "_default": 0.0}, "reporter": {"_type": "concentration", "_default": 0.0}}}}}, "emitter": {"_type": "step", "address": "local:RAMEmitter", "config": {"emit": {"env_substrate": "concentration", "cyto_substrate": "concentration", "nuc_substrate": "concentration", "reporter": "concentration", "time": "float"}}, "inputs": {"env_substrate": ["environment", "substrate"], "cyto_substrate": ["environment", "cell", "cytoplasm", "substrate"], "nuc_substrate": ["environment", "cell", "cytoplasm", "nucleus", "substrate"], "reporter": ["environment", "cell", "cytoplasm", "nucleus", "reporter"], "time": ["global_time"]}}, "_declared_emit_paths": ["environment/substrate", "environment/cell/cytoplasm/substrate", "environment/cell/cytoplasm/nucleus/substrate", "environment/cell/cytoplasm/nucleus/reporter", "global_time"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["PermeableBoundary", "LocalMetabolism", "RegulatedReporter"]}, "tags": [], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": 40, "preferred_time": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}