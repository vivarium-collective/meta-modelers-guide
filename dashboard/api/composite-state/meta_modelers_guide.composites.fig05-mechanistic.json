{"id": "meta_modelers_guide.composites.fig05-mechanistic", "name": "Disintegration \u2014 Adaptive Grain Refinement on a Quantified Inadequacy Signal", "description": "Fig 5 mechanistic variant. The cell's biological damage state (soluble + aggregated misfolded protein) evolves continuously and independently of the grain. A StressRamp5 drives stress up; GrainAdaptiveCell runs the cheap COARSE grain (linear, aggregation neglected) while a computable inadequacy estimator \u2014 the fraction of the damage dynamics carried by the neglected autocatalytic aggregation term \u2014 stays below tolerance, then REFINES to the FINE grain (resolving soluble vs aggregated protein, capturing the viability collapse the coarse model cannot see). The coarse\u2192fine map is conserving (prolongation is identity on the shared damage pools), so neither total damage nor biomass jumps at the switch (handover_error=0). mode=adaptive here; mode=coarse / mode=fine are the control arms. This is the mechanistic variant of fig05-grain-runnable (kept as the didactic baseline).", "parameters": {}, "state": {"stressor": {"_type": "process", "address": "local:StressRamp5", "interval": 1.0, "config": {"stress0": 0.15, "stress_rate": 0.03, "stress_max": 1.0}, "inputs": {}, "outputs": {"stress": ["physiology", "stress"]}, "interval_label": "1 s"}, "cell": {"_type": "process", "address": "local:GrainAdaptiveCell", "interval": 1.0, "config": {"mode": "adaptive", "k_stress": 0.045, "k_repair": 0.03, "energy": 1.0, "k_agg": 0.55, "w_sol": 0.35, "w_agg": 1.7, "mu": 0.12, "inadequacy_tol": 0.2}, "inputs": {"stress": ["physiology", "stress"], "m_sol": ["damage", "m_sol"], "m_agg": ["damage", "m_agg"], "biomass": ["cell_state", "biomass"]}, "outputs": {"m_sol": ["damage", "m_sol"], "m_agg": ["damage", "m_agg"], "biomass": ["cell_state", "biomass"], "damage": ["signals", "damage"], "viability": ["signals", "viability"], "active_grain": ["signals", "active_grain"], "inadequacy": ["signals", "inadequacy"], "handover_error": ["signals", "handover_error"]}, "interval_label": "1 s"}, "physiology": {"stress": {"_type": "concentration", "_default": 0.0}}, "damage": {"m_sol": {"_type": "concentration", "_default": 0.0}, "m_agg": {"_type": "concentration", "_default": 0.0}}, "cell_state": {"biomass": {"_type": "mass", "_default": 1.0}}, "signals": {"damage": {"_type": "concentration", "_default": 0.0}, "viability": {"_type": "viability", "_default": 0.0}, "active_grain": {"_type": "fraction", "_default": 0.0}, "inadequacy": {"_type": "fraction", "_default": 0.0}, "handover_error": {"_type": "concentration", "_default": 0.0}}, "emitter": {"_type": "step", "address": "local:RAMEmitter", "config": {"emit": {"stress": "concentration", "m_sol": "concentration", "m_agg": "concentration", "damage": "concentration", "viability": "viability", "biomass": "mass", "active_grain": "fraction", "inadequacy": "fraction", "handover_error": "concentration", "time": "float"}}, "inputs": {"stress": ["physiology", "stress"], "m_sol": ["damage", "m_sol"], "m_agg": ["damage", "m_agg"], "damage": ["signals", "damage"], "viability": ["signals", "viability"], "biomass": ["cell_state", "biomass"], "active_grain": ["signals", "active_grain"], "inadequacy": ["signals", "inadequacy"], "handover_error": ["signals", "handover_error"], "time": ["global_time"]}}, "_declared_emit_paths": ["physiology/stress", "damage/m_sol", "damage/m_agg", "signals/damage", "signals/viability", "cell_state/biomass", "signals/active_grain", "signals/inadequacy", "signals/handover_error", "global_time"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["StressRamp5", "GrainAdaptiveCell"]}, "tags": [], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": 36, "preferred_time": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}