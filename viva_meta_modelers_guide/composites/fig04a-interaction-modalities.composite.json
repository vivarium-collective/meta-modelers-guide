{
  "name": "fig04a-interaction-modalities",
  "description": "Fig 4a — four interaction-modality cards of the cellular interface: nutrient exchange (chemical flux), motile force (mechanical), growth rate, and electrical signaling. Each is a DRAFT process: unit-bearing ports + a behavior contract, no update dynamics. Ports are wired to labeled stores so each quantity (and its unit) appears as a node.",
  "requires": {
    "processes": ["NutrientExchange", "MotileForce", "Growth", "ElectricalSignaling"],
    "types": ["chemical_flux", "concentration", "area", "energy", "force", "growth_rate", "mass", "voltage", "signaling_rate", "current"]
  },
  "state": {
    "nutrient_exchange": {
      "_type": "process",
      "address": "local:NutrientExchange",
      "config": {"interval": 1.0},
      "inputs": {"nutrient_ext": ["chemical_exchange", "nutrient_ext"], "boundary": ["chemical_exchange", "boundary"]},
      "outputs": {"nutrient_uptake": ["chemical_exchange", "nutrient_uptake"], "secretion": ["chemical_exchange", "secretion"]}
    },
    "chemical_exchange": {
      "nutrient_ext": {"_type": "concentration", "_value": 0.0},
      "boundary": {"_type": "area", "_value": 0.0},
      "nutrient_uptake": {"_type": "chemical_flux", "_value": 0.0},
      "secretion": {"_type": "chemical_flux", "_value": 0.0}
    },
    "motile_force": {
      "_type": "process",
      "address": "local:MotileForce",
      "config": {"interval": 1.0},
      "inputs": {"energy": ["motility", "energy"]},
      "outputs": {"force": ["motility", "force"]}
    },
    "motility": {
      "energy": {"_type": "energy", "_value": 0.0},
      "force": {"_type": "force", "_value": 0.0}
    },
    "growth": {
      "_type": "process",
      "address": "local:Growth",
      "config": {"interval": 1.0},
      "inputs": {"substrate": ["biomass", "substrate"]},
      "outputs": {"growth_rate": ["biomass", "growth_rate"], "mass": ["biomass", "mass"]}
    },
    "biomass": {
      "substrate": {"_type": "chemical_flux", "_value": 0.0},
      "growth_rate": {"_type": "growth_rate", "_value": 0.0},
      "mass": {"_type": "mass", "_value": 0.0}
    },
    "electrical_signaling": {
      "_type": "process",
      "address": "local:ElectricalSignaling",
      "config": {"interval": 1.0},
      "inputs": {"membrane_potential": ["bioelectricity", "membrane_potential"]},
      "outputs": {"signal": ["bioelectricity", "signal"], "current": ["bioelectricity", "current"]}
    },
    "bioelectricity": {
      "membrane_potential": {"_type": "voltage", "_value": 0.0},
      "signal": {"_type": "signaling_rate", "_value": 0.0},
      "current": {"_type": "current", "_value": 0.0}
    }
  }
}
