{
  "name": "fig10-1-rewrite",
  "description": "Fig 10.1 as a GENUINE place-graph rewrite: chromosome segregation then cell division via Milner reaction rules over a tree[node] store. Running it ADDS nodes at runtime (1 cell -> 2 chromosomes -> 2 daughters) \u2014 steppable topology for the loom run/animate feature.",
  "requires": {
    "processes": [
      "CellCycleDivision"
    ]
  },
  "state": {
    "colony": {
      "_type": "tree[node]",
      "cell": {
        "_control": "cell",
        "contents": {
          "chromosome": {
            "_control": "chromosome",
            "contents": {
              "dna": 1.0
            }
          }
        }
      }
    },
    "cell_cycle": {
      "_type": "process",
      "address": "local:CellCycleDivision",
      "interval": 1.0,
      "config": {
        "cycle": 3.0
      },
      "inputs": {
        "colony": [
          "colony"
        ]
      },
      "outputs": {
        "colony": [
          "colony"
        ]
      }
    }
  },
  "emitters": [
    {
      "address": "local:SQLiteEmitter"
    }
  ]
}
