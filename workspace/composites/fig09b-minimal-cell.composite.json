{
  "name": "fig09b-minimal-cell",
  "description": "Fig 9b — minimal cell composition. The three functional columns of Fig 9a realized as a WIRED composite whose processes support one another through SHARED component stores. Four cellular processes — containment (lipids → membrane), metabolism (enzymes + nutrients → metabolites + energy), gene expression (genes → proteins + enzymes), and replication (genes + energy → gene copies + nucleic acids) — are coupled through the pools they share: metabolism makes the energy replication spends and the metabolites everything draws on; expression makes the enzymes metabolism needs; the building-block stores (proteins, nucleic acids, amino acids) that generic DIFFUSION (relaxes metabolite gradients) and REACTIONS (interconvert building blocks) keep supplied are read and written by all four. This web of mutual dependence through shared components is the minimal expression of autopoietic closure. All DRAFT processes: unit-bearing ports + behavior contracts, no update dynamics.",
  "requires": {
    "processes": ["MinimalCellContainment", "MinimalCellMetabolism", "GeneExpression", "MinimalCellReplication", "Diffusion", "Reactions"],
    "types": ["concentration", "area", "energy"]
  },
  "state": {
    "minimal_cell_containment": {
      "_type": "process",
      "address": "local:MinimalCellContainment",
      "config": {"interval": 1.0},
      "inputs": {"lipids": ["lipids", "concentration"]},
      "outputs": {"membrane": ["membrane", "area"]}
    },
    "minimal_cell_metabolism": {
      "_type": "process",
      "address": "local:MinimalCellMetabolism",
      "config": {"interval": 1.0},
      "inputs": {"enzymes": ["enzymes", "concentration"], "nutrients": ["nutrients", "concentration"]},
      "outputs": {"metabolites": ["metabolites", "concentration"], "energy": ["energy", "energy"]}
    },
    "gene_expression": {
      "_type": "process",
      "address": "local:GeneExpression",
      "config": {"interval": 1.0},
      "inputs": {"genes": ["genes", "concentration"], "amino_acids": ["amino_acids", "concentration"]},
      "outputs": {"proteins": ["proteins", "concentration"], "enzymes": ["enzymes", "concentration"]}
    },
    "minimal_cell_replication": {
      "_type": "process",
      "address": "local:MinimalCellReplication",
      "config": {"interval": 1.0},
      "inputs": {"genes": ["genes", "concentration"], "energy": ["energy", "energy"]},
      "outputs": {"genes": ["genes", "concentration"], "nucleic_acids": ["nucleic_acids", "concentration"]}
    },
    "diffusion": {
      "_type": "process",
      "address": "local:Diffusion",
      "config": {"interval": 1.0},
      "inputs": {"metabolites": ["metabolites", "concentration"]},
      "outputs": {"metabolites": ["metabolites", "concentration"]}
    },
    "reactions": {
      "_type": "process",
      "address": "local:Reactions",
      "config": {"interval": 1.0},
      "inputs": {"amino_acids": ["amino_acids", "concentration"], "nucleic_acids": ["nucleic_acids", "concentration"]},
      "outputs": {"proteins": ["proteins", "concentration"], "nucleic_acids": ["nucleic_acids", "concentration"]}
    },
    "membrane": {
      "area": {"_type": "area", "_value": 1.0}
    },
    "lipids": {
      "concentration": {"_type": "concentration", "_value": 1.0}
    },
    "metabolites": {
      "concentration": {"_type": "concentration", "_value": 1.0}
    },
    "enzymes": {
      "concentration": {"_type": "concentration", "_value": 1.0}
    },
    "genes": {
      "concentration": {"_type": "concentration", "_value": 1.0}
    },
    "nutrients": {
      "concentration": {"_type": "concentration", "_value": 1.0}
    },
    "energy": {
      "energy": {"_type": "energy", "_value": 1.0}
    },
    "proteins": {
      "concentration": {"_type": "concentration", "_value": 0.0}
    },
    "nucleic_acids": {
      "concentration": {"_type": "concentration", "_value": 1.0}
    },
    "amino_acids": {
      "concentration": {"_type": "concentration", "_value": 1.0}
    }
  }
}
