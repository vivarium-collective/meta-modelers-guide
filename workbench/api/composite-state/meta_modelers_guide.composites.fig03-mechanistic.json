{"id": "meta_modelers_guide.composites.fig03-mechanistic", "name": "The Cellular Interface \u2014 Mechanistic (shared ATP/enzyme coupling)", "description": "Fig 3 mechanistic variant: a cell whose interface ports are coupled through a shared ATP pool and a temperature-set enzyme activity. A nutrient step-down at t=12 propagates through uptake->ATP->growth/maintenance->viability. The metabolically-disabled control (catalytic_capacity=eps) breaks the propagation.", "parameters": {}, "state": {"cell": {"_type": "process", "address": "local:MetabolicCell", "interval": 1.0, "config": {"vmax_uptake": 1.0, "km": 0.5, "atp_yield": 1.4, "catalytic_capacity": 1.0, "temp_opt": 37.0, "temp_width": 9.0, "growth_max": 0.6, "k_atp": 1.0, "atp_per_biomass": 1.5, "maintenance_rate": 0.4, "atp_min": 0.0, "k_thermal": 0.02, "k_energy": 0.15}, "inputs": {"nutrient": ["env", "nutrient"], "temperature": ["env", "temperature"], "atp": ["cell_state", "atp"], "biomass": ["cell_state", "biomass"], "viability": ["cell_state", "viability"]}, "outputs": {"uptake": ["signals", "uptake"], "atp": ["cell_state", "atp"], "biomass": ["cell_state", "biomass"], "viability": ["cell_state", "viability"], "growth_rate": ["signals", "growth_rate"], "enzyme_activity": ["signals", "enzyme_activity"], "atp_production": ["signals", "atp_production"], "maintenance": ["signals", "maintenance"]}, "interval_label": "1 s"}, "env_driver": {"_type": "process", "address": "local:EnvironmentStep", "interval": 1.0, "config": {"nutrient_hi": 2.0, "nutrient_lo": 2.0, "nutrient_step_time": 1000000000.0, "temp_base": 37.0, "temp_step": 48.0, "temp_step_time": 12.0}, "inputs": {}, "outputs": {"nutrient": ["env", "nutrient"], "temperature": ["env", "temperature"]}, "interval_label": "1 s"}, "env": {"nutrient": {"_type": "concentration", "_default": 2.0}, "temperature": {"_type": "temperature", "_default": 37.0}}, "cell_state": {"atp": {"_type": "energy", "_default": 1.0}, "biomass": {"_type": "mass", "_default": 1.0}, "viability": {"_type": "viability", "_default": 1.0}}, "signals": {"uptake": {"_type": "chemical_flux", "_default": 0.0}, "growth_rate": {"_type": "growth_rate", "_default": 0.0}, "enzyme_activity": {"_type": "fraction", "_default": 0.0}, "atp_production": {"_type": "chemical_flux", "_default": 0.0}, "maintenance": {"_type": "chemical_flux", "_default": 0.0}}, "emitter": {"_type": "step", "address": "local:RAMEmitter", "config": {"emit": {"nutrient": "concentration", "temperature": "temperature", "atp": "energy", "biomass": "mass", "viability": "viability", "uptake": "chemical_flux", "growth_rate": "growth_rate", "enzyme_activity": "fraction", "atp_production": "chemical_flux", "time": "float"}}, "inputs": {"nutrient": ["env", "nutrient"], "temperature": ["env", "temperature"], "atp": ["cell_state", "atp"], "biomass": ["cell_state", "biomass"], "viability": ["cell_state", "viability"], "uptake": ["signals", "uptake"], "growth_rate": ["signals", "growth_rate"], "enzyme_activity": ["signals", "enzyme_activity"], "atp_production": ["signals", "atp_production"], "time": ["global_time"]}}, "_declared_emit_paths": ["env/nutrient", "env/temperature", "cell_state/atp", "cell_state/biomass", "cell_state/viability", "signals/uptake", "signals/growth_rate", "signals/enzyme_activity", "signals/atp_production", "global_time"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["MetabolicCell", "EnvironmentStep"]}, "tags": [], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": 24, "preferred_time": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}